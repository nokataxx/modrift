{
  "expo": {
    "name": "modrift",
    "slug": "modrift",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "modrift",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.modrift.app",
      "appleTeamId": "69DJBCFQQ3",
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSSupportsOpeningDocumentsInPlace": true,
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "ja"
        ],
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Markdown Document",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "net.daringfireball.markdown",
              "public.plain-text"
            ]
          }
        ]
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF"
        }
      ],
      "expo-localization",
      "./plugins/with-pod-deployment-target",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Light",
            "ios": "./assets/icon-src/modrift-icon-light-1024.png"
          },
          {
            "name": "Navy",
            "ios": "./assets/icon-src/modrift-icon-navy-1024.png"
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "52d700ed-7785-4afd-b930-528d7997c0ae"
      }
    },
    "owner": "nokata"
  }
}
