{
  "expo": {
    "name": "modrift",
    "slug": "modrift",
    "version": "1.5.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "modrift",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.modrift.app",
      "supportsTablet": true,
      "requireFullScreen": true,
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": [
          "iCloud.com.modrift.app"
        ],
        "com.apple.developer.icloud-services": [
          "CloudDocuments"
        ],
        "com.apple.developer.ubiquity-container-identifiers": [
          "iCloud.com.modrift.app"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSSupportsOpeningDocumentsInPlace": true,
        "UIFileSharingEnabled": true,
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "ja"
        ],
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Markdown Document",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "net.daringfireball.markdown",
              "public.plain-text"
            ]
          },
          {
            "CFBundleTypeName": "PDF Document",
            "LSHandlerRank": "Alternate",
            "CFBundleTypeRole": "Viewer",
            "LSItemContentTypes": [
              "com.adobe.pdf"
            ]
          },
          {
            "CFBundleTypeName": "Word Document",
            "LSHandlerRank": "Alternate",
            "CFBundleTypeRole": "Viewer",
            "LSItemContentTypes": [
              "org.openxmlformats.wordprocessingml.document"
            ]
          },
          {
            "CFBundleTypeName": "Excel Workbook",
            "LSHandlerRank": "Alternate",
            "CFBundleTypeRole": "Viewer",
            "LSItemContentTypes": [
              "org.openxmlformats.spreadsheetml.sheet"
            ]
          },
          {
            "CFBundleTypeName": "Image",
            "LSHandlerRank": "Alternate",
            "CFBundleTypeRole": "Viewer",
            "LSItemContentTypes": [
              "public.png",
              "public.jpeg",
              "com.compuserve.gif",
              "public.heic",
              "public.heif",
              "org.webmproject.webp"
            ]
          }
        ],
        "NSUbiquitousContainers": {
          "iCloud.com.modrift.app": {
            "NSUbiquitousContainerIsDocumentScopePublic": true,
            "NSUbiquitousContainerSupportedFolderLevels": "Any",
            "NSUbiquitousContainerName": "Modrift"
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.modrift.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-localization",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsFileWithMaxCount": 1
          },
          "iosShareExtensionName": "Modrift Share",
          "iosAppGroupIdentifier": "group.com.modrift.app",
          "disableAndroid": true
        }
      ],
      "./plugins/with-share-extension-xcode-fixes",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Light",
            "ios": "./assets/icon-src/modrift-icon-light-1024.png"
          },
          {
            "name": "Navy",
            "ios": "./assets/icon-src/modrift-icon-navy-1024.png"
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "52d700ed-7785-4afd-b930-528d7997c0ae"
      },
      "revenueCatApiKey": "appl_SVWgRGbMhtbUAKmdlzXaopXtKzC"
    },
    "owner": "nokata"
  }
}
